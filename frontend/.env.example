# Keep the existing single-user desktop workflow until server auth is available.
# This is not a mock login. No test credentials are bundled.
VITE_AUTH_MODE=none

# Enable only after the backend implements the contract in frontend/README.md.
# VITE_AUTH_MODE=server
VITE_AUTH_LOGIN_PATH=/api/auth/login
VITE_AUTH_ME_PATH=/api/auth/me
VITE_AUTH_LOGOUT_PATH=/api/auth/logout
