# 复制为 backend/.env 后按需修改；请勿把真实密钥写入仓库。
# 默认使用 mock，无需任何外部 API 密钥。

# 数据库与文件存储（路径相对启动目录 backend/；默认值使用项目内绝对路径）
# ZHENLU_DATABASE_URL=sqlite:///./data/zhenlu.db
# ZHENLU_UPLOAD_DIR=./data/uploads
# ZHENLU_SAMPLE_DATA_DIR=../sample-data
ZHENLU_MAX_AUDIO_MB=50

# 服务提供方：ASR 支持 mock 或 fun-asr；草稿支持 mock 或 qwen。
ZHENLU_ASR_PROVIDER=mock
ZHENLU_DRAFT_PROVIDER=mock

# 启用 Fun-ASR 实时语音识别时，将 ASR 提供方改为 fun-asr，并填写百炼控制台对应地域/业务空间的 WebSocket 接口地址。
# 地址必须为 wss://；本机测试可使用 ws://localhost。也可以继续使用公共地址 wss://dashscope.aliyuncs.com/api-ws/v1/inference。
# 密钥放在本地环境中，切勿提交或发送到前端。上传的音频会发送至该服务。
# ZHENLU_FUN_ASR_BASE_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# ZHENLU_FUN_ASR_MODEL=fun-asr-realtime-2026-02-28
# ZHENLU_FUN_ASR_API_KEY=
# ZHENLU_FUN_ASR_WORKSPACE=
# ZHENLU_FUN_ASR_TIMEOUT_SECONDS=300
# ZHENLU_FUN_ASR_SAMPLE_RATE=16000
# ZHENLU_FUN_ASR_LANGUAGE_HINTS=zh
# ZHENLU_FUN_ASR_CHUNK_INTERVAL_SECONDS=0.1

# 启用千问时，将草稿提供方改为 qwen，并填写百炼控制台对应地域的实际接口地址。
# 模型可以设为 qwen3.7-plus 或 qwen3.8-flash。密钥放在本地环境中，切勿提交或发送到前端。
# ZHENLU_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ZHENLU_QWEN_MODEL=qwen3.7-plus
# ZHENLU_QWEN_API_KEY=
# ZHENLU_QWEN_TIMEOUT_SECONDS=45
# ZHENLU_QWEN_ATTEMPT_TIMEOUT_SECONDS=20
# ZHENLU_QWEN_MAX_RETRIES=1
# ZHENLU_QWEN_MAX_TOKENS=2000
# 如需估算费用，按当前模型、地域的实际价格设置，单位为元/百万 tokens；留空不估价。
# ZHENLU_QWEN_INPUT_PRICE_PER_MILLION=
# ZHENLU_QWEN_OUTPUT_PRICE_PER_MILLION=

# 会话问答：mock 为本地字段摘录，qwen 使用上面的千问配置。
ZHENLU_ASSISTANT_PROVIDER=mock
# 对话角色：rules 只识别明确角色前缀；qwen 进行带来源的角色推断。
ZHENLU_DIALOGUE_PROVIDER=rules

# 后台任务保存在数据库中；开启后每个服务进程启动一个处理线程。
ZHENLU_JOB_WORKER_ENABLED=true
ZHENLU_JOB_POLL_INTERVAL_SECONDS=0.5
ZHENLU_JOB_LEASE_SECONDS=600

# 模拟处理延迟，便于观察处理中状态
ZHENLU_MOCK_DELAY_SECONDS=0.35

# 跨域与展示时区
ZHENLU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ZHENLU_TIMEZONE_OFFSET_HOURS=8
