# Target and flash size
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# CPU 240 MHz (dual core: audio capture and network on separate cores)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM: octal mode 80 MHz (N16R8 module)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# FreeRTOS 1 kHz tick: jitter control for 20 ms audio frames
CONFIG_FREERTOS_HZ=1000

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Console: custom UART0 at 921600 so the same CH343 port can carry base64 audio
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_GPIO=43
CONFIG_ESP_CONSOLE_UART_RX_GPIO=44
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# I2S audio input (digital MEMS microphone, Philips standard mode)
CONFIG_AUDIO_IN_I2S_BCLK=5
CONFIG_AUDIO_IN_I2S_WS=4
CONFIG_AUDIO_IN_I2S_DIN=6
CONFIG_AUDIO_IN_GAIN_DB=0
CONFIG_VAD_MAX_MS=30000
CONFIG_SEG_TX_STREAM=y
CONFIG_SEG_TX_RING_SECONDS=60
